# HTML pages — always revalidate (fixes iOS Safari stale cache)
/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Hashed JS/CSS assets — cache forever (Vite fingerprints filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# API — never cache
/api/*
  Cache-Control: no-store
